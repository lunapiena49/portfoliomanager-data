---
import '../styles/global.css';
import type { Locale } from '../i18n/index';
import { LOCALES } from '../i18n/index';

/** Sezione del sito: decide l'accento (menta / blu / ember) via [data-section]. */
export type Section = 'company' | 'finance' | 'games';
/** Tipo di pagina: decide lo schema JSON-LD emesso. */
export type PageType = 'organization' | 'software' | 'game' | 'page';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  lang: Locale;
  section?: Section;
  pageType?: PageType;
  /** false = pagina senza traduzioni 1:1 (es. un post del blog): niente hreflang. */
  alternates?: boolean;
  /** Legacy: qualche pagina lo passa ancora. Se assente si deriva dall'URL. */
  canonicalPath?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  lang,
  section = 'finance',
  pageType = 'page',
  alternates = true,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Dominio custom attivo dal 2026-05-04. Override solo per anteprime di staging:
//   SITE_URL=https://lunapiena49.github.io/portfoliomanager-data astro build
const siteUrl = (import.meta.env.SITE_URL as string | undefined) ?? 'https://plurifin.app';

/* --- Rotta canonica derivata dall'URL reale della pagina ---------------
   Serve per canonical + hreflang CORRETTI su ogni pagina: prima venivano
   emessi hreflang che puntavano SEMPRE alla home, quindi ogni pagina
   tradotta dichiarava come propria alternativa la home, non se stessa.
   NB: build.format = 'file' -> gli URL NON hanno lo slash finale
   (/en e' 200, /en/ e' 404). Ogni costruzione di link parte da qui. */
let path = Astro.url.pathname;
if (base && path.startsWith(base)) path = path.slice(base.length);
path = path.replace(/^\/+/, '').replace(/\/+$/, '').replace(/\.html$/, '');
const segments = path ? path.split('/') : [];
const hasLangPrefix =
  segments.length > 0 && (LOCALES as string[]).includes(segments[0]) && segments[0] !== 'it';
const route = (hasLangPrefix ? segments.slice(1) : segments).join('/');

function localeHref(l: Locale, r: string): string {
  const seg = [l === 'it' ? '' : l, r].filter(Boolean).join('/');
  return seg ? `${siteUrl}/${seg}` : `${siteUrl}/`;
}

const canonicalUrl = localeHref(lang, route);
const ogImageUrl = `${siteUrl}/assets/og-image.png`;
const goatcounterHost = import.meta.env.GOATCOUNTER_HOST as string | undefined;

const publisher = {
  '@type': 'Organization',
  name: 'PluriFin',
  url: siteUrl,
  founder: { '@type': 'Person', name: 'Filippo Salemi' },
  address: { '@type': 'PostalAddress', addressCountry: 'IT' },
};

let jsonLd: Record<string, unknown>;
if (pageType === 'organization') {
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'PluriFin',
    url: siteUrl,
    logo: `${siteUrl}/assets/favicon.svg`,
    image: ogImageUrl,
    description: ogDescription ?? description,
    // NON un Gmail personale: questo JSON-LD spedisce su 42 pagine su 99, ed e'
    // il contatto che Google mostra nel Knowledge Panel. `info@` e' uno dei 5
    // alias verificati via API in S9 (i 3 di S10 - legal@/gdpr@/support@ - non
    // lo sono ancora: il catch-all Cloudflare e' su Drop, quindi un alias senza
    // regola di routing attiva perde la posta IN SILENZIO).
    email: 'info@plurifin.app',
    founder: { '@type': 'Person', name: 'Filippo Salemi' },
    address: { '@type': 'PostalAddress', addressCountry: 'IT' },
    sameAs: ['https://github.com/lunapiena49'],
  };
} else if (pageType === 'software') {
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Portfolio Manager',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Android, Web',
    url: canonicalUrl,
    image: ogImageUrl,
    description: ogDescription ?? description,
    inLanguage: lang,
    softwareVersion: '1.0.0',
    datePublished: '2026-05-02',
    publisher,
    // Solo la web demo gratuita e' effettivamente disponibile (InStock reale).
    // I piani Premium NON sono acquistabili: l'account commerciante Google
    // Payments non esiste ancora, quindi dichiarare un Offer InStock a prezzo
    // sarebbe markup ingannevole (Google lo penalizza). I prezzi di lancio
    // vivono nella pagina /pricing come ANNUNCIO, non come offerta commerciale
    // attiva: gli acquisti si aprono alla pubblicazione su Play Store.
    offers: [
      {
        '@type': 'Offer',
        price: '0.00',
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        name: 'Web demo (free)',
      },
    ],
  };
} else if (pageType === 'game') {
  // ROLLQUEST e' IN SVILUPPO: niente offerte, niente datePublished, niente
  // rating. Dichiarare una disponibilita' che non esiste sarebbe markup
  // ingannevole (e Google lo penalizza).
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: 'ROLLQUEST',
    url: canonicalUrl,
    image: ogImageUrl,
    description: ogDescription ?? description,
    applicationCategory: 'GameApplication',
    gamePlatform: 'Android',
    operatingSystem: 'Android',
    inLanguage: LOCALES,
    publisher,
  };
} else {
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    url: canonicalUrl,
    description: ogDescription ?? description,
    inLanguage: lang,
    isPartOf: { '@type': 'WebSite', name: 'PluriFin', url: siteUrl },
  };
}
---
<!DOCTYPE html>
<html lang={lang} dir="ltr" data-section={section}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Tema applicato PRIMA del primo paint: niente lampo bianco.
       Ordine: scelta esplicita dell'utente > preferenza di sistema. -->
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('pf-theme');
        var dark = saved
          ? saved === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={ogTitle ?? title} />
  <meta property="og:description" content={ogDescription ?? description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang} />
  <meta property="og:site_name" content="PluriFin" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle ?? title} />
  <meta name="twitter:description" content={ogDescription ?? description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <!-- hreflang: puntano alla STESSA pagina nelle altre lingue, non alla home. -->
  {alternates && LOCALES.map(l => (
    <link rel="alternate" hreflang={l} href={localeHref(l, route)} />
  ))}
  {alternates && <link rel="alternate" hreflang="x-default" href={localeHref('it', route)} />}

  <link rel="icon" type="image/svg+xml" href={`${base}/assets/favicon.svg`} />
  <link rel="apple-touch-icon" href={`${base}/assets/apple-touch-icon.png`} />

  <!-- Font self-hosted (nessun CDN terzo: v. global.css). In preload solo il
       subset latin; latin-ext si carica solo se serve. -->
  <link
    rel="preload"
    as="font"
    type="font/woff2"
    href={`${base}/assets/fonts/inter-latin.woff2`}
    crossorigin
  />

  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#F8F9FA" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0A0E14" media="(prefers-color-scheme: dark)" />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body>
  <a href="#main" class="skip">Skip to content</a>
  <slot />

  {goatcounterHost && (
    <script
      data-goatcounter={`https://${goatcounterHost}/count`}
      async
      src="//gc.zgo.at/count.js"
    />
  )}

  <script>
    // Rivelazione allo scroll (la variante ridotta e' in global.css).
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            observer.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

    // Toggle del tema. Il bottone vive nella Navbar; qui c'e' la logica, cosi'
    // funziona anche nelle pagine che usano una navbar ridotta.
    const root = document.documentElement;
    const toggles = document.querySelectorAll('[data-theme-toggle]');

    const isDark = () => root.getAttribute('data-theme') === 'dark';

    function applyTheme(theme: 'light' | 'dark') {
      root.setAttribute('data-theme', theme);
      try {
        localStorage.setItem('pf-theme', theme);
      } catch (e) {
        /* storage negato: il tema resta valido per questa pagina */
      }
      toggles.forEach((btn) => btn.setAttribute('aria-pressed', String(theme === 'dark')));
    }

    toggles.forEach((btn) => {
      btn.setAttribute('aria-pressed', String(isDark()));
      btn.addEventListener('click', () => applyTheme(isDark() ? 'light' : 'dark'));
    });
  </script>
</body>
</html>
