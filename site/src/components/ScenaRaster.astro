<style>
  /* IL RIM SU UN RASTER NON E' IL RIM SU UN PATH, e i numeri della scena
     vettoriale qui non si ereditano: `drop-shadow` lavora sull'ALFA, e l'alfa
     di un path e' netta mentre quella di un PNG generato e' antialiasata su
     2-3 px. La stessa coppia di passate che sul vettoriale disegna un filo
     produce sul raster una nuvola - l'utente l'ha vista e l'ha detta:
     *"gli aloni intorno a corvax e rollo sono troppo innaturali"*.
     La passata STRETTA e' quella che fa il lavoro di canone (portare il valore
     al bordo, pavimento 3:1 sul fondo) e resta; quella LARGA, che serviva solo
     a dare corpo, si dimezza e perde alfa. Il rapporto fra le due bande e' lo
     stesso su tutti e tre gli scaglioni di scala, come nell'originale: i
     raggi restano una FUNZIONE della scala di resa, non dei numeri. */
  .scene {
    position: relative; height: 560px; overflow: hidden;
    --rim-n: 5px;
    --rim-w: 6px;
    --rimf-n: 4px;
    --rimf-w: 5px;
  }
  .lyr {
    position: absolute; left: 0; right: 0; top: -44px; bottom: -36px;
    pointer-events: none; will-change: transform;
  }
  .lyr svg { width: 100%; height: 100%; display: block; }

  @media (max-width: 900px) {
    .scene {
      height: 400px;
      --rim-n: 7.2px; --rim-w: 8.7px; --rimf-n: 5.8px; --rimf-w: 7.2px;
    }
    .lyr { top: -22px; bottom: -22px; }
  }

  @media (max-width: 600px) {
    .scene { height: 62.5vw; }
    .scene {
      height: auto; aspect-ratio: 8 / 5;
      --rim-n: 13px; --rim-w: 15.7px; --rimf-n: 10.4px; --rimf-w: 13px;
    }
    .lyr { top: -10px; bottom: -10px; }
  }

  .lyr :global(.rim) {
    filter: drop-shadow(0 0 var(--rim-n) rgba(168,184,224,1))
            drop-shadow(0 0 var(--rim-w) rgba(168,184,224,.75));
  }
  .lyr :global(.rim-far) {
    filter: drop-shadow(0 0 var(--rimf-n) rgba(168,184,224,1))
            drop-shadow(0 0 var(--rimf-w) rgba(168,184,224,.70));
  }

  .lyr :global(.eye) { animation: eye 2.6s ease-in-out infinite; }
  @keyframes eye { 0%, 100% { opacity: 1; } 50% { opacity: .42; } }
  .lyr :global(.glow) { animation: glow 2.2s ease-in-out infinite; }
  @keyframes glow { 0%, 100% { opacity: .32; } 50% { opacity: .72; } }
  .lyr :global(.lit) { animation: lit 3.4s ease-in-out infinite; }
  @keyframes lit { 0%, 100% { opacity: .95; } 50% { opacity: .6; } }

  .embers { position: absolute; inset: 0; z-index: 3; pointer-events: none; overflow: hidden; }
  .embers :global(.em) {
    position: absolute; bottom: -14px; width: 5px; height: 5px; border-radius: 50%;
    background: #FF8A3D; box-shadow: 0 0 10px #FFC24B;
    opacity: 0; animation: rise linear infinite;
  }
  @keyframes rise {
    0%   { opacity: 0; transform: translate(0,0) scale(.5); }
    10%  { opacity: .9; }
    100% { opacity: 0; transform: translate(var(--dx, 0px), -430px) scale(1.15); }
  }
  @media (prefers-reduced-motion: reduce) {
    .embers :global(.em) { display: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

  const emb = document.getElementById('embers');
  if (emb && !reduce) {
    for (let i = 0; i < 30; i++) {
      const e = document.createElement('span');
      e.className = 'em';
      e.style.left = (Math.random() * 100) + '%';
      e.style.animationDuration = (5 + Math.random() * 7) + 's';
      e.style.animationDelay = (Math.random() * 9) + 's';
      e.style.setProperty('--dx', (Math.random() * 90 - 45) + 'px');
      emb.appendChild(e);
    }
  }

  const sceneEl = document.getElementById('scene');
  const lyrs = Array.from(document.querySelectorAll<HTMLElement>('.lyr'));
  const parAmp = () => (innerWidth <= 600 ? 4 : innerWidth <= 900 ? 8 : 22);
  let ticking = false;

  function onScroll() {
    if (reduce || !sceneEl) return;
    const vh = innerHeight;
    const sr = sceneEl.getBoundingClientRect();
    const p = clamp((vh - sr.top) / (vh + sr.height), 0, 1);
    const k = (.5 - p) * 2 * parAmp();
    for (const l of lyrs) {
      l.style.transform = `translate3d(0,${(k * parseFloat(l.dataset.par!)).toFixed(1)}px,0)`;
    }
    ticking = false;
  }

  addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
  }, { passive: true });
  addEventListener('resize', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
  }, { passive: true });
  onScroll();
</script>
