---
import type { Translations } from '../i18n/index';
import { LOCALE_NAMES } from '../i18n/index';

interface Props { t: Translations; }
const { t } = Astro.props;

// Qui c'era: const FORMSPREE_NEWSLETTER = '.../f/PLACEHOLDER_NEWSLETTER_ID'
// Un ID SEGNAPOSTO. Il form sotto raccoglieva email + lingua + un CONSENSO GDPR
// obbligatorio, il fetch falliva, il catch faceva un submit NATIVO verso un 404
// e l'utente leggeva "Iscritto!". Non si iscriveva nessuno, e il consenso
// spariva. S11 ha trovato e rimosso QUESTO STESSO difetto nel form contatti;
// questo, a due file di distanza, ha continuato a spedire su 6 pagine.
// Finche' non esiste un endpoint PROVATO (mandarci un messaggio e verificarlo
// nella casella), qui c'e' un indirizzo vero. Nessun dato raccolto dal browser
// -> nessun consenso da chiedere, e la promessa del testo ("riceverai una sola
// email al lancio") torna mantenibile, perche' la mail arriva a una casella viva.
---
<div class="modal-bg" id="modalBg" role="dialog" aria-modal="true" aria-labelledby="modal-title" aria-hidden="true">
  <div class="modal modal-wrap">
    <button class="modal-close" id="modalClose" aria-label="Close">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <h3 id="modal-title">{t.modal.title}</h3>
    <p>{t.modal.sub}</p>

    <!-- Un indirizzo vero, non un form che finge. La casella e' viva: `info@` e'
         uno dei 5 alias VERIFICATI via API in S9 (i 3 di S10 no, e il catch-all
         Cloudflare e' su Drop: un alias senza regola di routing attiva perde la
         posta in silenzio). -->
    <div class="modal-actions">
      <a class="btn btn-primary" href="mailto:info@plurifin.app?subject=Avvisami%20al%20lancio">info@plurifin.app</a>
      <button type="button" class="btn btn-ghost" id="modalCancelBtn">{t.lang === 'it' ? 'Chiudi' : 'Close'}</button>
    </div>
  </div>
</div>

<style>
  .modal-bg {
    position: fixed;
    inset: 0;
    background: rgba(14,17,22,.55);
    z-index: 200;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }
  .modal-bg.open { display: flex; }
  .modal {
    background: var(--surface);
    border-radius: var(--radius-xl);
    padding: 36px;
    max-width: 480px;
    width: 100%;
    box-shadow: var(--shadow-elev);
    position: relative;
  }
  .modal h3 { font-size: 24px; margin-bottom: 8px; }
  .modal > p { color: var(--text-2); font-size: 15px; margin-bottom: 24px; }
  /* S16: rimosse le regole del form (form-row, input email, lang-radios,
     gdpr, success-msg): il form non esiste piu' dal fix S12 - il markup e'
     un mailto - e quel CSS non vestiva piu' nessuno. */
  .modal-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
  }
  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--text-3);
    display: grid;
    place-items: center;
    transition: background .12s, color .12s;
    cursor: pointer;
  }
  .modal-close:hover { background: var(--bg); color: var(--text); }

  @media (max-width: 480px) {
    .modal { padding: 24px; }
    .modal-actions { flex-direction: column-reverse; }
    .modal-actions .btn { width: 100%; justify-content: center; }
  }
</style>

<script>
  const bg = document.getElementById('modalBg');
  const closeBtn = document.getElementById('modalClose');
  const cancelBtn = document.getElementById('modalCancelBtn');

  function openModal() {
    if (!bg) return;
    bg.classList.add('open');
    bg.setAttribute('aria-hidden', 'false');
    const firstInput = bg.querySelector('input, button') as HTMLElement | null;
    firstInput?.focus();
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    if (!bg) return;
    bg.classList.remove('open');
    bg.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.addEventListener('open-modal', openModal);
  closeBtn?.addEventListener('click', closeModal);
  cancelBtn?.addEventListener('click', closeModal);
  bg?.addEventListener('click', (e: MouseEvent) => {
    if (e.target === bg) closeModal();
  });
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') closeModal();
  });

  // Nessun handler di submit: non c'e' piu' un form. Quello di prima faceva
  // `fetch` -> `catch` -> `form.submit()` NATIVO verso un endpoint segnaposto
  // (404), dopo aver mostrato "Iscritto!". Il difetto non era il catch: era
  // promettere una consegna che non esisteva.
</script>
