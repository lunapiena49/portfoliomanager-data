---
/**
 * LA SCENA DI ROLLQUEST - divisione Games. Porting fedele del prototipo v7.
 *
 * Cinque piani, UN viewBox (4800x900), una regola di prospettiva:
 *   orizzonte y=560, scala(y) = (y-560)/240.
 * Rollo (170u a scala 1) e' l'unita' di misura: Corvax = 1.8 Rollo, la Torre =
 * 13 Rollo ma sta lontana (base y=610 -> scala 0.21), percio' e' alta 460u e
 * non 2210. Il contorno si assottiglia con la distanza (5u davanti, 4 sul cast,
 * 2.5 sui crinali, 2 sulla Torre, 0 sul fondale) e il colore si lava verso il
 * cielo: e' cosi' che la profondita' si legge invece di appiattirsi.
 *
 * PERCHE' IL viewBox E' LARGO 4800 E NON 2400: con `slice` la scala e'
 * max(W/vbW, H/vbH). Se il contenitore e' piu' "largo" del viewBox, il ritaglio
 * cade in ALTEZZA - e su uno schermo largo mangiava la cima della Torre. Con un
 * rapporto 5.33 il contenitore resta sempre piu' stretto, quindi il ritaglio
 * cade SEMPRE ai lati e l'altezza si vede tutta. Il prezzo e' che i bordi
 * vanno riempiti: per questo il terreno arriva a x=-1300 e x=3700.
 *
 * LE DUE SONDE (data-probe) SONO IL CONTRATTO con l'harness visivo. Non
 * dipingono nulla: sono geometria, non inchiostro. Se spariscono, i test
 * diventano ciechi ai difetti #4 e #1 - e `targets/contract.spec.ts` fallisce
 * apposta per impedirlo.
 */
import type { Translations } from '../i18n/index';

interface Props {
  t: Translations;
}
const { t } = Astro.props;
---
<div class="scene" id="scene" role="img" aria-label={t.company.gamesBand.sceneAlt}>

  <!-- P5 - il fondale. Il sole sta DENTRO il viewBox: non puo' scollarsi
       dall'orizzonte a nessuna larghezza. -->
  <div class="lyr" data-par="0.30">
    <svg viewBox="0 0 4800 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <radialGradient id="gSun">
          <stop offset="0%" stop-color="#FFF8E4" stop-opacity=".95"/>
          <stop offset="26%" stop-color="#FFDFA8" stop-opacity=".62"/>
          <stop offset="58%" stop-color="#FFBC84" stop-opacity=".24"/>
          <stop offset="100%" stop-color="#FF9E62" stop-opacity="0"/>
        </radialGradient>
        <linearGradient id="gHaze" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#FFDCB4" stop-opacity="0"/>
          <stop offset="100%" stop-color="#FFE6C8" stop-opacity=".8"/>
        </linearGradient>
      </defs>
      <g transform="translate(1200,0)">
        <circle cx="1200" cy="556" r="370" fill="url(#gSun)"/>
        <circle cx="1200" cy="558" r="78" fill="#FFF4D8" opacity=".9"/>
        <!-- guglie lontanissime: zero contorno, tinta gia' meta' cielo -->
        <g fill="#C8A8C4" opacity=".36">
          <path d="M-1080 580 L-1080 520 L-1064 494 L-1048 520 L-1048 580 Z"/>
          <path d="M-880 582 L-880 542 L-868 522 L-856 542 L-856 582 Z"/>
          <path d="M-600 578 L-600 508 L-582 478 L-564 508 L-564 578 Z"/>
          <path d="M-320 582 L-320 536 L-306 514 L-292 536 L-292 582 Z"/>
          <path d="M-90 580 L-90 514 L-72 486 L-54 514 L-54 580 Z"/>
          <path d="M170 580 L170 512 L186 486 L202 512 L202 580 Z"/>
          <path d="M300 582 L300 538 L314 518 L328 538 L328 582 Z"/>
          <path d="M470 578 L470 496 L488 466 L506 496 L506 578 Z"/>
          <path d="M640 582 L640 542 L652 522 L664 542 L664 582 Z"/>
          <path d="M860 580 L860 524 L874 500 L888 524 L888 580 Z"/>
          <path d="M1520 580 L1520 520 L1536 494 L1552 520 L1552 580 Z"/>
          <path d="M1900 578 L1900 502 L1918 472 L1936 502 L1936 578 Z"/>
          <path d="M2050 582 L2050 540 L2063 520 L2076 540 L2076 582 Z"/>
          <path d="M2220 580 L2220 516 L2237 490 L2254 516 L2254 580 Z"/>
          <path d="M2460 582 L2460 534 L2474 512 L2488 534 L2488 582 Z"/>
          <path d="M2700 578 L2700 500 L2718 470 L2736 500 L2736 578 Z"/>
          <path d="M2960 582 L2960 540 L2973 520 L2986 540 L2986 582 Z"/>
          <path d="M3220 580 L3220 510 L3238 482 L3256 510 L3256 580 Z"/>
          <path d="M3480 582 L3480 538 L3494 516 L3508 538 L3508 582 Z"/>
        </g>
        <rect x="-1300" y="498" width="5000" height="130" fill="url(#gHaze)"/>
      </g>
    </svg>
  </div>

  <!-- P4 - crinale lontano + LA TORRE (13 Rollo, ma lontana) -->
  <div class="lyr" data-par="0.50">
    <svg viewBox="0 0 4800 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
     <g transform="translate(1200,0)">
      <path d="M-1300 636 L0 618 Q 320 572 640 598 Q 940 622 1240 590 Q 1540 560 1840 594 Q 2140 626 2400 588
               L3700 612 L3700 900 L-1300 900 Z"
            fill="#C2A6C2" opacity=".8"/>

      <!-- LA TORRE. Contorno 2u: e' lontana, il segno deve pesare meno.
           Quattro tronchi rastremati separati da ballatoi che sporgono: i PIANI
           si devono contare, perche' il gioco consiste nel salirli. La porta
           alla base da' la scala - senza, una torre e' solo un cilindro di
           dimensione ignota. -->
      <g stroke="#3A3153" stroke-width="2" stroke-linejoin="round">
        <!-- tronco 1 (base) -->
        <path d="M1630 665 L1634 558 L1766 558 L1770 665 Z" fill="#F6E7D2"/>
        <path d="M1630 665 L1634 558 L1700 558 L1700 665 Z" fill="#C8ACBE" stroke="none"/>
        <path d="M1682 665 L1682 640 Q1700 622 1718 640 L1718 665 Z" fill="#6E5C7E"/>
        <!-- ballatoio 1 -->
        <path d="M1622 540 L1778 540 L1774 558 L1626 558 Z" fill="#EADAC4"/>
        <path d="M1622 540 L1700 540 L1700 558 L1626 558 Z" fill="#BC9EB2" stroke="none"/>
        <!-- tronco 2 -->
        <path d="M1638 540 L1642 428 L1758 428 L1762 540 Z" fill="#F6E7D2"/>
        <path d="M1638 540 L1642 428 L1700 428 L1700 540 Z" fill="#C8ACBE" stroke="none"/>
        <!-- ballatoio 2 -->
        <path d="M1630 410 L1770 410 L1766 428 L1634 428 Z" fill="#EADAC4"/>
        <path d="M1630 410 L1700 410 L1700 428 L1634 428 Z" fill="#BC9EB2" stroke="none"/>
        <!-- tronco 3 -->
        <path d="M1647 410 L1650 303 L1750 303 L1753 410 Z" fill="#F6E7D2"/>
        <path d="M1647 410 L1650 303 L1700 303 L1700 410 Z" fill="#C8ACBE" stroke="none"/>
        <!-- ballatoio 3 -->
        <path d="M1639 285 L1761 285 L1757 303 L1643 303 Z" fill="#EADAC4"/>
        <path d="M1639 285 L1700 285 L1700 303 L1643 303 Z" fill="#BC9EB2" stroke="none"/>
        <!-- tronco 4 (cima) -->
        <path d="M1656 285 L1658 200 L1742 200 L1744 285 Z" fill="#F6E7D2"/>
        <path d="M1656 285 L1658 200 L1700 200 L1700 285 Z" fill="#C8ACBE" stroke="none"/>
        <!-- merlature -->
        <g fill="#EADAC4">
          <path d="M1656 200 L1656 180 L1668 180 L1668 200 Z"/>
          <path d="M1675 200 L1675 180 L1687 180 L1687 200 Z"/>
          <path d="M1694 200 L1694 180 L1706 180 L1706 200 Z"/>
          <path d="M1713 200 L1713 180 L1725 180 L1725 200 Z"/>
          <path d="M1732 200 L1732 180 L1744 180 L1744 200 Z"/>
        </g>
        <!-- guglia + bandiera -->
        <path d="M1700 125 L1754 180 L1646 180 Z" fill="#FF8A3D"/>
        <path d="M1700 125 L1700 180 L1646 180 Z" fill="#D9662B" stroke="none"/>
        <path d="M1700 125 L1700 90" stroke-width="3"/>
        <path d="M1700 92 L1746 104 L1700 116 Z" fill="#FFC24B"/>

        <!-- SONDA = LA SAGOMA DELLA TORRE. Non "la sua cima": la sagoma.
             (difetti #4 e #4-ter)

             Era `x=1694 w=56` -> copriva 1694..1750: la guglia, e basta. Ma il
             ballatoio 1 (v. sopra) arriva a **1778**, +1 di stroke = **1779**:
             29 unita' di Torre che NESSUN test guardava. E la regola CSS qui
             sotto era derivata dallo stesso bordo sbagliato ("la Torre arriva a
             x=2950" = 1750+1200: e' dove finisce LA SONDA, non la Torre).

             Conseguenza, MISURATA sul dist servito, non calcolata:
                 W=360  il test leggeva 13,8px di margine | la Torre ne aveva 5,3
                 W=280  il test leggeva  8,0px (= la sua soglia: VERDE) | 1,3
             Il test pretendeva 8px su un rettangolo che finisce 29 unita' prima
             del bordo vero: garantiva la sonda, non la Torre. E' il difetto #4
             per la TERZA volta - "curare i punti che si testano non e' curare" -
             e stavolta il punto che si testava era dentro il disegno.

             Ora il rettangolo E' la bounding box della Torre (stroke incluso):
             x 1621..1779, y 88 (asta della bandiera) .. 665 (base). Il test del
             margine orizzontale e quello della cima ora misurano la stessa cosa
             che l'utente vede. Non dipinge nulla. -->
        <rect data-probe="tower-top" x="1621" y="88" width="158" height="577"
              fill="none" stroke="none" pointer-events="none"/>

        <!-- finestre accese: una per piano, la torre e' abitata -->
        <g fill="#FFC24B" stroke="none">
          <rect class="lit" x="1722" y="592" width="16" height="24" rx="8"/>
          <rect class="lit" x="1652" y="462" width="16" height="24" rx="8" style="animation-delay:-1.4s"/>
          <rect class="lit" x="1716" y="470" width="16" height="24" rx="8" style="animation-delay:-2.2s"/>
          <rect class="lit" x="1660" y="336" width="16" height="24" rx="8" style="animation-delay:-.7s"/>
          <rect class="lit" x="1724" y="344" width="16" height="24" rx="8" style="animation-delay:-3.1s"/>
          <rect class="lit" x="1692" y="228" width="16" height="24" rx="8" style="animation-delay:-1.9s"/>
        </g>
      </g>
     </g>
    </svg>
  </div>

  <!-- P3 - crinale medio: occlude la base della Torre. Il verde comincia -->
  <div class="lyr" data-par="0.75">
    <svg viewBox="0 0 4800 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
     <g transform="translate(1200,0)">
      <path d="M-1300 682 L0 664 Q 280 616 560 642 Q 840 668 1120 634 Q 1420 598 1720 638 Q 2020 676 2400 626
               L3700 652 L3700 900 L-1300 900 Z"
            fill="#A2B993" stroke="#3A3153" stroke-width="2.5" stroke-opacity=".3" stroke-linejoin="round"/>
      <g fill="#7FA173" opacity=".8">
        <path d="M-900 668 L-894 644 L-888 668 Z"/><circle cx="-891" cy="636" r="15"/>
        <path d="M-420 660 L-414 638 L-408 660 Z"/><circle cx="-411" cy="630" r="13"/>
        <path d="M-120 648 L-114 624 L-108 648 Z"/><circle cx="-111" cy="616" r="16"/>
        <path d="M420 640 L426 616 L432 640 Z"/><circle cx="429" cy="608" r="16"/>
        <path d="M620 652 L626 630 L632 652 Z"/><circle cx="629" cy="622" r="13"/>
        <path d="M1320 626 L1326 602 L1332 626 Z"/><circle cx="1329" cy="594" r="15"/>
        <path d="M2010 656 L2016 632 L2022 656 Z"/><circle cx="2019" cy="624" r="14"/>
        <path d="M2540 644 L2546 620 L2552 644 Z"/><circle cx="2549" cy="612" r="15"/>
        <path d="M2980 664 L2986 640 L2992 664 Z"/><circle cx="2989" cy="632" r="14"/>
        <path d="M3420 656 L3426 634 L3432 656 Z"/><circle cx="3429" cy="626" r="13"/>
      </g>
     </g>
    </svg>
  </div>

  <!-- P2 - il prato su cui poggiano DAVVERO, le ombre di contatto, il cast -->
  <div class="lyr" data-par="1.00">
    <svg viewBox="0 0 4800 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <radialGradient id="gDie">
          <stop offset="0%" stop-color="#FFD98A" stop-opacity=".9"/>
          <stop offset="100%" stop-color="#FFC24B" stop-opacity="0"/>
        </radialGradient>
      </defs>
     <g transform="translate(1200,0)">
      <path d="M-1300 806 L0 792 Q 300 758 640 778 Q 980 798 1320 772 Q 1660 746 2000 780 Q 2210 798 2400 774
               L3700 796 L3700 900 L-1300 900 Z"
            fill="#7FA871" stroke="#3A3153" stroke-width="3" stroke-opacity=".45" stroke-linejoin="round"/>

      <!-- OMBRE DI CONTATTO: senza queste, tutto galleggia. Sotto i piedi, non
           "vicino ai piedi". Il dado ne ha una piu' piccola e piu' chiara: e' in
           aria, e si vede. -->
      <ellipse cx="1000" cy="806" rx="66" ry="12" fill="#3A3153" opacity=".24"/>
      <ellipse cx="1388" cy="790" rx="134" ry="18" fill="#3A3153" opacity=".22"/>
      <ellipse cx="1180" cy="800" rx="28" ry="7" fill="#3A3153" opacity=".12"/>

      <!-- SONDA - il fondo delle ombre di contatto (difetto #1).
           E' l'estremo BASSO del contenuto vivo, come la cima della Torre e'
           quello alto. La scena deve contenerli tutti e due, a ogni larghezza e
           in ogni punto dello scroll: se le ombre escono dal bordo, le figure
           tornano a galleggiare. -->
      <rect data-probe="hero-feet" x="934" y="794" width="588" height="24"
            fill="none" stroke="none" pointer-events="none"/>

      <!-- ================= ROLLO =================
           Corpo a pera, elmo semisferico con visiera a UNA fessura, scudo
           esagonale sulla schiena. Ha appena lanciato: il braccio e' alzato. -->
      <g stroke="#3A3153" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
        <path d="M930 706 L962 724 L962 760 L930 778 L898 760 L898 724 Z" fill="#3EC6C0"/>
        <path d="M930 718 L951 730 L951 754 L930 766 L909 754 L909 730 Z" fill="none" stroke="#FFC24B" stroke-width="3"/>
        <path d="M950 780 L982 780 L982 806 Q982 812 972 812 L954 812 Q946 812 947 804 Z" fill="#35429A"/>
        <path d="M1018 780 L1050 780 L1052 804 Q1053 812 1045 812 L1027 812 Q1017 812 1017 806 Z" fill="#35429A"/>
        <path d="M1000 698 C1052 698 1068 746 1062 786 C1060 794 1040 798 1000 798 C960 798 940 794 938 786 C932 746 948 698 1000 698 Z" fill="#5566CC"/>
        <!-- ombra: cel-shading a due toni, mai un gradiente -->
        <path d="M1000 698 C948 698 932 746 938 786 C940 794 960 798 1000 798 Z" fill="#3F4CA8" stroke="none"/>
        <path d="M944 760 Q1000 770 1058 760 L1056 776 Q1000 786 946 776 Z" fill="#FFC24B"/>
        <circle cx="1000" cy="770" r="8" fill="#FF8A3D"/>
        <path d="M1048 724 Q1082 706 1098 670" fill="none" stroke-width="27"/>
        <path d="M1048 724 Q1082 706 1098 670" fill="none" stroke="#5566CC" stroke-width="19"/>
        <circle cx="1100" cy="666" r="15" fill="#EDF1F7"/>
        <path d="M960 678 L1040 678 L1036 700 Q1000 711 964 700 Z" fill="#D5DCE7"/>
        <path d="M958 678 A42 42 0 0 1 1042 678 Z" fill="#EDF1F7"/>
        <path d="M958 678 A42 42 0 0 1 1000 636 L1000 678 Z" fill="#C3CBD9" stroke="none"/>
        <path d="M984 644 Q1000 620 1016 644 Q1000 638 984 644 Z" fill="#FF8A3D"/>
        <rect x="972" y="684" width="56" height="9" rx="4.5" fill="#241E36" stroke="none"/>
        <rect class="lit" x="988" y="686" width="20" height="4" rx="2" fill="#3EC6C0" stroke="none"/>
      </g>

      <!-- ================= IL DADO =================
           L'istante e' sospeso: fermo a mezz'aria. Nessuna animazione di forma
           dentro un SVG grande - solo l'alone pulsa (opacita' = compositor). -->
      <circle class="glow" cx="1180" cy="616" r="82" fill="url(#gDie)"/>
      <g stroke="#3A3153" stroke-width="4" stroke-linejoin="round">
        <path d="M1180 582 L1212 599 L1180 616 L1148 599 Z" fill="#FFF6EA"/>
        <path d="M1148 599 L1180 616 L1180 652 L1148 635 Z" fill="#CFB9A4"/>
        <path d="M1212 599 L1180 616 L1180 652 L1212 635 Z" fill="#E9D7C0"/>
        <g fill="#FFC24B" stroke="none">
          <path d="M1180 592 L1183 598 L1189 599 L1183 602 L1180 608 L1177 602 L1171 599 L1177 598 Z"/>
          <path d="M1164 616 L1166 621 L1171 622 L1166 625 L1164 630 L1162 625 L1157 622 L1162 621 Z"/>
          <path d="M1196 618 L1198 623 L1203 624 L1198 627 L1196 632 L1194 627 L1189 624 L1194 623 Z"/>
        </g>
      </g>
      <g fill="#FFC24B" opacity=".9">
        <path class="glow" d="M1252 566 L1256 578 L1268 582 L1256 586 L1252 598 L1248 586 L1236 582 L1248 578 Z"/>
        <path class="glow" d="M1116 556 L1119 565 L1128 568 L1119 571 L1116 580 L1113 571 L1104 568 L1113 565 Z" style="animation-delay:-1.1s"/>
      </g>

      <!-- ================= RE CORVAX =================
           ALTO E TRIANGOLARE: becco lungo, corona a 3 punte STORTA, mantello di
           piume a zig-zag. Il triangolo non lo fa il contorno, lo fa la
           DISTRIBUZIONE della massa: corona, testa e collo stanno dentro
           76-120u di larghezza; solo sotto le spalle il mantello si apre fino a
           270. Prima era largo quasi quanto alto - ed e' per questo che leggeva
           "pinguino" invece che "re corvo". -->
      <g stroke="#3A3153" stroke-width="4" stroke-linejoin="round" stroke-linecap="round">
        <path d="M1334 770 L1334 788 M1318 788 L1352 788" stroke="#FFC24B" stroke-width="7" fill="none"/>
        <path d="M1428 770 L1428 788 M1412 788 L1446 788" stroke="#FFC24B" stroke-width="7" fill="none"/>

        <!-- UN CORPO SOLO. Cranio, collo e mantello sono LO STESSO profilo: e'
             cosi' che un corvo si legge. Montandolo a pezzi la testa galleggia
             e il corpo diventa una tenda. -->
        <path d="M1380 496
                 Q1418 500 1424 542 Q1428 578 1444 616
                 L1474 706 L1494 788
                 L1470 764 L1448 792 L1424 764 L1400 794 L1380 766
                 L1360 794 L1336 764 L1312 792 L1290 764 L1266 788
                 L1286 706 L1316 616
                 Q1332 578 1336 542 Q1342 500 1380 496 Z" fill="#7B4FE0"/>
        <path d="M1380 496
                 Q1342 500 1336 542 Q1332 578 1316 616
                 L1286 706 L1266 788
                 L1290 764 L1312 792 L1336 764 L1360 794 L1380 766 Z" fill="#5734B8" stroke="none"/>
        <path d="M1348 622 Q1310 700 1302 778" fill="none" stroke-width="3.5" stroke-opacity=".45"/>
        <path d="M1412 622 Q1450 700 1458 778" fill="none" stroke-width="3.5" stroke-opacity=".45"/>
        <path d="M1330 600 Q1380 634 1432 600" fill="none" stroke-width="4" stroke-opacity=".55"/>
        <path d="M1318 664 Q1380 696 1444 664" fill="none" stroke-width="3.5" stroke-opacity=".45"/>
        <path d="M1344 522 Q1298 534 1256 550 Q1298 560 1348 556 Z" fill="#FFC24B"/>
        <path d="M1344 540 Q1300 548 1256 550" fill="none" stroke-width="2.5" stroke-opacity=".6"/>
        <ellipse class="eye" cx="1366" cy="528" rx="8" ry="10" fill="#FF6B6B" stroke-width="3"/>
        <ellipse class="eye" cx="1402" cy="524" rx="8" ry="10" fill="#FF6B6B" stroke-width="3" style="animation-delay:-.5s"/>
        <g transform="rotate(-10 1382 500)">
          <path d="M1346 504 L1354 466 L1372 492 L1384 454 L1398 490 L1416 464 L1422 504 Z" fill="#FFC24B"/>
          <circle cx="1384" cy="470" r="5" fill="#9B6BFF" stroke-width="2.5"/>
        </g>
      </g>
     </g>
    </svg>
  </div>

  <!-- P1 - primissimo piano. I CIUFFI sono l'unica cosa che tocca il cast:
       passano DAVANTI ai piedi di Rollo e alla base di Corvax. Un oggetto che
       niente copre non poggia su niente - e' la definizione tecnica di
       "incollato sopra". Sono ciuffi separati, non una fascia: negli spazi in
       mezzo si vedono gli stivali, ed e' li' che la figura entra nel terreno
       invece di stare appoggiata sul vetro. -->
  <div class="lyr" data-par="1.40">
    <svg viewBox="0 0 4800 900" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
     <g transform="translate(1200,0)">
      <path d="M-1300 846 L0 838 Q 240 816 500 830 Q 760 844 1020 826 Q 1280 808 1540 828 Q 1800 848 2060 824 Q 2230 810 2400 828
               L3700 842 L3700 900 L-1300 900 Z"
            fill="#4C7355" stroke="#3A3153" stroke-width="5" stroke-opacity=".6" stroke-linejoin="round"/>
      <g fill="#41654A" stroke="#3A3153" stroke-width="4" stroke-linejoin="round" stroke-opacity=".5">
        <!-- davanti ai piedi di Rollo (i suoi stivali stanno a y 780-812) -->
        <path d="M934 830 Q941 792 950 826 Q959 784 968 824 Q975 796 980 830 Z"/>
        <path d="M988 828 Q995 786 1004 822 Q1013 778 1021 820 Q1027 792 1032 828 Z"/>
        <path d="M1040 832 Q1047 796 1055 828 Q1063 790 1070 830 Z"/>
        <!-- alla base del mantello di Corvax -->
        <path d="M1288 814 Q1295 776 1304 810 Q1313 772 1322 808 Q1329 784 1334 814 Z"/>
        <path d="M1442 816 Q1449 780 1458 812 Q1467 776 1476 810 Z"/>
        <!-- riempimento, fino ai bordi larghi -->
        <path d="M-1020 848 Q-1010 812 -1000 846 Q-990 816 -980 848 Z"/>
        <path d="M-560 840 Q-550 804 -540 838 Q-530 808 -520 840 Z"/>
        <path d="M-140 836 Q-130 800 -120 834 Z"/>
        <path d="M600 842 Q610 806 620 840 Q630 810 640 842 Z"/>
        <path d="M1900 830 Q1910 794 1920 828 Q1930 800 1940 830 Z"/>
        <path d="M2180 824 Q2190 790 2200 822 Z"/>
        <path d="M2620 838 Q2630 802 2640 836 Q2650 806 2660 838 Z"/>
        <path d="M3080 846 Q3090 810 3100 844 Z"/>
        <path d="M3480 840 Q3490 806 3500 838 Q3510 810 3520 840 Z"/>
      </g>
      <g fill="#FFC24B" stroke="none" opacity=".85">
        <circle cx="878" cy="836" r="5"/><circle cx="1108" cy="842" r="4"/>
        <circle cx="1560" cy="834" r="5"/><circle cx="700" cy="846" r="4"/>
        <circle cx="-320" cy="844" r="5"/><circle cx="2380" cy="838" r="4"/>
        <circle cx="2900" cy="846" r="5"/>
      </g>
     </g>
    </svg>
  </div>

  <div class="embers" id="embers"></div>
</div>

<style>
  /* I piani si muovono SOLO con translate3d: lavoro del compositor, zero
     repaint. Il margine negativo (top/bottom) e' la corsa del parallasse. */
  .scene { position: relative; height: 560px; overflow: hidden; }
  .lyr {
    position: absolute; left: 0; right: 0; top: -44px; bottom: -36px;
    pointer-events: none; will-change: transform;
  }
  .lyr svg { width: 100%; height: 100%; display: block; }

  /* SCHERMO STRETTO: la scena si abbassa a 400px, e li' non ci sta piu' niente.
     La finestra visibile, in unita' di viewBox, e' 900*S/(S+riserve): con S=400
     e 80px di riserve fa 750 unita' - ma il contenuto vivo, dalla cima della
     Torre (y=88) al fondo delle ombre (y=818), ne occupa 730. Restano venti
     unita' di margine e la corsa dei piani se le mangia tutte. Misurato a
     390px: cima a -1px, ombre a -3px. Tagliate tutte e due.
     Qui le riserve si stringono (la finestra si allarga a 810 unita') e la
     corsa si accorcia (parAmp, nello script). Sopra i 900px non cambia UN
     PIXEL: la composizione approvata in S7 e' quella, e non si tocca. */
  @media (max-width: 900px) {
    .scene { height: 400px; }
    .lyr { top: -22px; bottom: -22px; }
  }

  /* TELEFONO VERO (<= 600px): L'ALTEZZA SEGUE LA LARGHEZZA, E NON E' UN VEZZO.
     -----------------------------------------------------------------------
     Due difetti, uno dentro l'altro, e vale la pena raccontarli.

     (1) Il prototipo v7 non aveva il meta-viewport. Con `isMobile`, Chrome gli
     dava il layout di default (980px CSS) e lo scalava: il "mobile" su cui
     l'harness misurava era una pagina larga 980, non 390. Il sito Astro il
     meta-viewport ce l'ha - com'e' giusto - e a 390px veri la Torre USCIVA di
     76px a destra.

     (2) La prima cura fu un'altezza FISSA (270px sotto i 600). Risolveva a
     390px - il viewport piu' stretto della matrice - e un oracolo adversariale
     ha fatto notare che a 360px il margine scendeva a **0,3px**, e sotto i 359
     la Torre usciva di nuovo. **360px e' la larghezza Android piu' diffusa al
     mondo** (Galaxy, Pixel). Era il difetto #4 daccapo, con altri numeri: "il
     mio browser era 1568, quello dell'utente 1920" diventato "il mio minimo e'
     390, quello dell'utente e' 360". Curare i punti che si testano non e'
     curare: e' spostare il bordo del precipizio appena fuori dall'inquadratura.

     LA REGOLA, invece dei numeri. Con `slice` la scala e' max(W/4800, H/900);
     su schermo stretto vince il verticale, quindi s = H/900 e la finestra
     orizzontale visibile vale W/s unita' di viewBox, CENTRATA su 2400 (xMid).

     (3) LA REGOLA ERA GIUSTA, IL NUMERO NO. Diceva: "la Torre arriva a x=2950,
     cioe' 550 unita' oltre il centro". **2950 e' dove finiva la SONDA**
     (1750+1200), non la Torre: il ballatoio 1 arriva a 1778 +1 di stroke, cioe'
     **2979 -> 579 unita'**. Le 29 unita' mancanti erano quasi esattamente il
     margine m=30 che la disuguaglianza si metteva in tasca: la garanzia se le
     mangiava tutte. Misurato sul dist SERVITO (non calcolato): a 360px il test
     leggeva 13,8px e la Torre ne aveva **5,3**; a 280px il test leggeva 8,0 -
     la sua soglia esatta, verde - e la Torre era a **1,3px** dal taglio.

         2400 + (W/2)/s  >=  2979 + m       ->       s <= (W/2) / (579 + m)
         e siccome s = H/900:                        H <= 450*W / (579 + m)

     Con m = 30 unita': **H_layer <= 0,739 * W**. L'altezza ammessa e'
     PROPORZIONALE alla larghezza - quindi si esprime con un `aspect-ratio`, non
     con un numero. Il vecchio 10/7 (0,70*W + 20 di riserve) soddisfaceva questa
     disuguaglianza solo da W >= 514px: sotto, NO. Serve **8/5** (0,625*W):
     H_layer = 0,625*W + 20 <= 0,739*W per ogni W >= 176px. Ma 176px e' il bordo
     della SOLA disuguaglianza della Torre - NON e' il pavimento della scena. Gli
     altri due vincoli (ombre, piano P1) cedono prima: l'oracolo S12 ha misurato
     hero-feet ROSSO a 264px (6,8 < 8), quindi il pavimento VERO della scena e'
     ~285px, non 176. Resta comunque sotto il viewport testato piu' stretto (360px,
     androidSmall), dove tutto e' verde, e il bordo dei 600px ora lo sorveglia il
     viewport `narrow` (601px). La scena e' piu' bassa dell'11% su mobile, e la
     Torre guadagna il margine che le spettava. Sopra i 600px non cambia nulla: la
     media query non si applica.

     Gli altri due vincoli tirano nel verso OPPOSTO (abbassare la scena stringe
     le riserve del parallasse), e vanno verificati al caso PEGGIORE, 320px:
       - ombre di contatto (y=818): cadono a 82*s = 22px dal fondo del layer,
         che sporge di 10px sotto la scena -> 12px dentro; la corsa del piano P2
         (4px) ne mangia 4. Restano ~8px.
       - piano P1: corre 4 * 1,40 = 5,6px contro 10px di riserva -> non scopre
         il bordo (4,4px di copertura).
     Tre vincoli in conflitto su ~244px di altezza. Ognuno dei tre ha un test, e
     il test della Torre ora pretende un MARGINE, non il semplice "dentro": zero
     e' il bordo del precipizio, non una verifica. */
  @media (max-width: 600px) {
    /* `aspect-ratio` senza fallback: su un browser che non lo supporta (Safari
       < 15) `height:auto` su un contenitore di soli figli assoluti collassa a
       ZERO e la scena sparisce. Il fallback tiene in piedi l'altezza. */
    .scene { height: 62.5vw; }
    .scene { height: auto; aspect-ratio: 8 / 5; }
    .lyr { top: -10px; bottom: -10px; }
  }

  /* Anima solo l'opacita': proprieta' del compositor, non ridipinge nulla.
     Nessuna animazione di FORMA dentro un SVG a schermo pieno. */
  .lyr :global(.eye) { animation: eye 2.6s ease-in-out infinite; }
  @keyframes eye { 0%, 100% { opacity: 1; } 50% { opacity: .42; } }
  .lyr :global(.glow) { animation: glow 2.2s ease-in-out infinite; }
  @keyframes glow { 0%, 100% { opacity: .32; } 50% { opacity: .72; } }
  .lyr :global(.lit) { animation: lit 3.4s ease-in-out infinite; }
  @keyframes lit { 0%, 100% { opacity: .95; } 50% { opacity: .6; } }

  .embers { position: absolute; inset: 0; z-index: 3; pointer-events: none; overflow: hidden; }
  .embers :global(.em) {
    position: absolute; bottom: -14px; width: 5px; height: 5px; border-radius: 50%;
    background: #FF8A3D; box-shadow: 0 0 10px #FFC24B;
    opacity: 0; animation: rise linear infinite;
  }
  @keyframes rise {
    0%   { opacity: 0; transform: translate(0,0) scale(.5); }
    10%  { opacity: .9; }
    100% { opacity: 0; transform: translate(var(--dx, 0px), -430px) scale(1.15); }
  }
  @media (prefers-reduced-motion: reduce) {
    .embers :global(.em) { display: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

  const emb = document.getElementById('embers');
  if (emb && !reduce) {
    for (let i = 0; i < 30; i++) {
      const e = document.createElement('span');
      e.className = 'em';
      e.style.left = (Math.random() * 100) + '%';
      e.style.animationDuration = (5 + Math.random() * 7) + 's';
      e.style.animationDelay = (Math.random() * 9) + 's';
      e.style.setProperty('--dx', (Math.random() * 90 - 45) + 'px');
      emb.appendChild(e);
    }
  }

  /* PARALLASSE. I piani vicini corrono di piu' dei lontani. La corsa e'
     volutamente corta perche' i margini negativi dei layer sono la loro unica
     riserva: se corressero di piu' scoprirebbero i bordi della scena.
     Su schermo stretto e' piu' corta ancora, e non per gusto: li' la scena e'
     alta 400px invece di 560, la finestra sul viewBox si stringe, e la cima
     della Torre e le ombre finiscono a pochi pixel dai bordi. Con la corsa
     lunga la parallasse li spingeva fuori - misurato, non temuto. */
  const sceneEl = document.getElementById('scene');
  const lyrs = Array.from(document.querySelectorAll<HTMLElement>('.lyr'));
  /* La corsa si accorcia insieme alla scena. Sotto i 600px la scena e' alta
     0,625*W (aspect-ratio 8/5) e le riserve sono 10px: al caso peggiore (320px) una corsa da 6
     mangerebbe 8,4px sul piano P1 e lascerebbe le ombre a filo. Quattro bastano
     - 5,6px sul piano piu' veloce contro 10px di riserva - e la profondita' a
     quella scala si legge lo stesso. V. il commento nel CSS. */
  const parAmp = () => (innerWidth <= 600 ? 4 : innerWidth <= 900 ? 8 : 22);
  let ticking = false;

  function onScroll() {
    if (reduce || !sceneEl) return;
    const vh = innerHeight;
    const sr = sceneEl.getBoundingClientRect();
    const p = clamp((vh - sr.top) / (vh + sr.height), 0, 1); /* 0 entra, 1 esce */
    const k = (.5 - p) * 2 * parAmp();
    for (const l of lyrs) {
      l.style.transform = `translate3d(0,${(k * parseFloat(l.dataset.par!)).toFixed(1)}px,0)`;
    }
    ticking = false;
  }

  /* Il ciclo NON resta acceso: si sveglia sullo scroll, fa un frame, si spegne.
     Un rAF che gira a vuoto dietro una pagina ferma e' il difetto #6, e vale
     anche qui - non solo sulla soglia. */
  addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
  }, { passive: true });
  addEventListener('resize', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
  }, { passive: true });
  onScroll();
</script>
