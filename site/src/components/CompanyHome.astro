---
/**
 * LA HOME AZIENDALE (rotta `/home`) - il sito che nel prototipo v7 stava dietro
 * la soglia. Qui e' una pagina vera, raggiungibile anche senza passare
 * dall'introduzione: chi torna, chi arriva da un link, chi arriva da Google.
 *
 * Contiene le DUE divisioni, e le tiene distinte:
 *   - la banda FINANCE rimanda al Portfolio Manager (che esiste, e' in test);
 *   - la banda GAMES rimanda a ROLLQUEST (che e' IN SVILUPPO: nessuno store,
 *     nessuna data, nessun download - "entra nel cantiere" e' la verita').
 * Niente prezzi qui dentro: il prezzo vive in /pricing, che e' la sua sede.
 */
import type { Translations, Locale } from '../i18n/index';
import { localePath } from '../i18n/index';
import CompanyNav from './CompanyNav.astro';
import Phone3D from './Phone3D.astro';
import Die3D from './Die3D.astro';
/* S95: la scena RASTER e' PROMOSSA, con approvazione esplicita dell'utente
   sull'anteprima (la stessa che in S81 aveva fermato la promozione).
   I tre rilievi che l'avevano fermata sono chiusi, ognuno con la sua fonte:
     - Corvax: ora e' il BOSS del gioco (`s7165`), bit-identico a
       `art/export/boss/spr_boss_a1_corvax_ombra.png` - consegna S83;
     - Rollo: NON esiste un approvato nuovo, e non deve esistere - decisione
       utente S91, l'S57 e' la FORMA BASE del protagonista, che in gioco
       cambiera' con l'equipaggiamento. Stato dichiarato e accettato, non una
       svista: quel file usa 45 tinte contro le ~128 di Torre e Corvax;
     - Torre: `s6739` (S87) e RICOMPOSTA a 680u = 4,0x Rollo, col piede a 780
       coperto dal crinale medio invece che sospeso sopra di esso.
   Il DEPLOY resta un passo separato e deliberato (PR verso il repo pubblico):
   promuovere qui non pubblica niente. Il provino resta su /provino-scena.
   Da questa riga dipende l'armamento del presidio: `scena_registro.promossa()`
   legge proprio questo import. */
import Scena from './ScenaRaster.astro';
import Footer from './Footer.astro';

interface Props {
  t: Translations;
  lang: Locale;
}

const { t, lang } = Astro.props;
const c = t.company;
const financeUrl = localePath(lang, 'finance');
const gamesUrl = localePath(lang, 'games');
const pressUrl = localePath(lang, 'press');
---
<CompanyNav t={t} lang={lang} />

<main id="main">
  <!-- Il filo: si disegna man mano che scendi, e lega l'hero alla prima banda. -->
  <div class="wrap hero reveal">
    <h1>{c.hero.h1a}<br /><em>{c.hero.h1b}</em></h1>
    <p>{c.hero.lede}</p>
    <svg class="thread" id="thread" viewBox="0 0 3 120" aria-hidden="true">
      <defs>
        <linearGradient id="gThread" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#26D896"/><stop offset="100%" stop-color="#1E88E5"/>
        </linearGradient>
      </defs>
      <line x1="1.5" y1="0" x2="1.5" y2="120" />
    </svg>
  </div>

  <!-- ---------------- FINANCE: Portfolio Manager ---------------- -->
  <section class="fin-band" id="finance" aria-labelledby="fin-h">
    <div class="wrap cols">
      <div class="reveal">
        <p class="lab">{c.financeBand.lab}</p>
        <h2 class="h2" id="fin-h">{c.financeBand.h2}</h2>
        <p class="lede" set:html={c.financeBand.lede} />

        <div class="facts">
          <div class="fact">
            <span class="ico" style="background:rgba(0,191,165,.16);color:#00BFA5">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/></svg>
            </span>
            <span set:html={c.financeBand.fact1} />
          </div>
          <div class="fact">
            <span class="ico" style="background:rgba(30,136,229,.18);color:#6EB6F5">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
            </span>
            <span set:html={c.financeBand.fact2} />
          </div>
          <div class="fact">
            <span class="ico" style="background:rgba(74,90,185,.22);color:#8E9BE8">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 2v20M17 6H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </span>
            <span set:html={c.financeBand.fact3} />
          </div>
        </div>

        <!-- 11, non 12: i parser nativi in parser_factory.dart sono undici.
             Il dodicesimo era il lettore CSV generico, che non e' un broker. -->
        <div class="stats">
          <div><span class="n" data-count="11">0</span><span class="l">{c.financeBand.statBrokers}</span></div>
          <div><span class="n" data-count="6">0</span><span class="l">{c.financeBand.statLangs}</span></div>
          <div><span class="n" data-count="0">0</span><span class="l">{c.financeBand.statServers}</span></div>
        </div>

        <a class="cta cta-fin" href={financeUrl} data-magnetic>{c.financeBand.cta}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
               stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="reveal">
        <Phone3D />
        <div class="ticker" aria-hidden="true"><div class="tk-track" id="tkTrack"></div></div>
        <p class="tk-cap">{c.financeBand.tickerCap}</p>
      </div>
    </div>
  </section>

  <!-- ---------------- GAMES: ROLLQUEST ---------------- -->
  <section class="gam-band" id="games" aria-labelledby="gam-h">
    <div class="wrap cols gam-in">
      <div class="reveal">
        <div class="gam-card">
          <p class="lab">{c.gamesBand.lab}</p>
          <h2 class="h2" id="gam-h">{c.gamesBand.h2}</h2>
          <p class="lede" set:html={c.gamesBand.lede} />

          <div class="facts">
            <div class="fact">
              <span class="ico" style="background:rgba(20,16,31,.55);color:#58C470">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span set:html={c.gamesBand.fact1} />
            </div>
            <div class="fact">
              <span class="ico" style="background:rgba(20,16,31,.55);color:#B58CFF">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 3l2.6 5.6 6.1.7-4.5 4.1 1.2 6-5.4-3-5.4 3 1.2-6L3.3 9.3l6.1-.7Z"/></svg>
              </span>
              <span set:html={c.gamesBand.fact2} />
            </div>
            <div class="fact">
              <span class="ico" style="background:rgba(20,16,31,.55);color:#FF8A3D">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18"/></svg>
              </span>
              <span set:html={c.gamesBand.fact3} />
            </div>
          </div>

          <a class="cta cta-gam" href={gamesUrl} data-magnetic>{c.gamesBand.cta}
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"
                 stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>

      <div class="reveal">
        <Die3D t={t} />
      </div>
    </div>

    <Scena t={t} />
  </section>

  <!-- ---------------- LO STUDIO ---------------- -->
  <section class="about" id="studio" aria-labelledby="studio-h">
    <div class="wrap reveal">
      <h3 id="studio-h">{c.studio.h3}</h3>
      <p>{c.studio.body}</p>
      <div class="row">
        <a class="chip" href={`mailto:${c.studio.press}`}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          {c.studio.press}
        </a>
        <a class="chip" href={pressUrl}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/></svg>
          {c.studio.pressKit}
        </a>
      </div>
    </div>
  </section>
</main>

<Footer t={t} currentLang={lang} />

<style>
  /* La home aziendale e' SCURA in entrambi i temi: e' la vetrina del marchio,
     non una pagina di lettura lunga. Le pagine di contenuto (/finance, le
     legali) seguono [data-theme]; questa no, ed e' una scelta, non una
     dimenticanza.
     E PROPRIO PER QUESTO I TITOLI VOGLIONO UN COLORE ESPLICITO. global.css ha
         h1, h2, h3, h4 { color: var(--text); }
     che e' piu' specifica di `main { color }` e vince. In tema CHIARO - che e'
     il default - `--text` e' quasi nero: su questo fondo scuro i titoli
     sparivano. "Portfolio Manager" era scritto in #0A0E14 sopra #0A0E14, ed e'
     stato visto guardando uno screenshot, non da un test: la suite sorveglia il
     contrasto DENTRO il telefono, non quello dei titoli della pagina. */
  main {
    background: #0A0E14;
    color: #F4F6F9;
  }
  main :global(h1),
  main :global(h2),
  main :global(h3) { color: #F4F6F9; }

  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 26px; }

  .hero {
    padding: 100px 0 40px; text-align: center; position: relative;
    background:
      radial-gradient(70% 90% at 20% 0%, rgba(74,90,185,.20), transparent 62%),
      radial-gradient(60% 80% at 82% 12%, rgba(0,191,165,.13), transparent 60%);
  }
  .hero h1 { margin: 0; font-size: clamp(34px, 5.2vw, 60px); line-height: 1.04; letter-spacing: -.042em; font-weight: 700; }
  .hero h1 em {
    font-style: normal;
    background: linear-gradient(96deg, #4A5AB9, #1E88E5 26%, #3EC6C0 52%, #26D896 74%, #FFC24B 100%);
    background-size: 240% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    animation: hue 11s ease-in-out infinite;
  }
  @keyframes hue { 0%,100% { background-position: 0 0; } 50% { background-position: 100% 0; } }
  .hero p { margin: 24px auto 0; max-width: 58ch; color: #AEB7C4; font-size: 17px; }

  .thread { display: block; margin: 36px auto 0; width: 3px; height: 120px; overflow: visible; }
  .thread line {
    stroke: url(#gThread); stroke-width: 3; stroke-linecap: round;
    stroke-dasharray: 120; stroke-dashoffset: calc(120 - 120 * var(--tp, 0));
  }

  /* =========== FINANCE =========== */
  .fin-band {
    position: relative; padding: 56px 0 100px; overflow: hidden;
    background:
      radial-gradient(80% 70% at 12% 18%, rgba(30,136,229,.16), transparent 60%),
      radial-gradient(70% 60% at 92% 70%, rgba(0,191,165,.12), transparent 58%),
      radial-gradient(60% 60% at 50% 110%, rgba(74,90,185,.18), transparent 60%);
  }
  .cols { display: grid; grid-template-columns: 1.18fr .82fr; gap: 56px; align-items: center; }
  .lab {
    font-size: 10.5px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase;
    display: inline-flex; align-items: center; gap: 9px; color: #6EB6F5; margin: 0;
  }
  .lab::before { content: ''; width: 24px; height: 1px; background: currentColor; opacity: .55; }
  .h2 { margin: 14px 0 0; font-size: clamp(30px, 3.6vw, 44px); letter-spacing: -.032em; font-weight: 700; }
  .lede { margin: 18px 0 0; max-width: 52ch; font-size: 16.5px; line-height: 1.68; color: #AEB7C4; }
  .lede :global(b) { color: #F4F6F9; font-weight: 600; }

  .facts { margin: 28px 0 0; display: flex; flex-direction: column; gap: 14px; max-width: 52ch; }
  .fact { display: flex; gap: 13px; align-items: flex-start; font-size: 14.5px; color: #AEB7C4; }
  .fact .ico { width: 26px; height: 26px; border-radius: 8px; flex: none; display: grid; place-items: center; margin-top: 1px; }
  .fact .ico svg { width: 14px; height: 14px; }
  .fact :global(b) { color: #F4F6F9; font-weight: 600; }

  .stats { display: flex; gap: 36px; margin-top: 30px; flex-wrap: wrap; }
  .stats div { display: flex; flex-direction: column; }
  .stats .n {
    font-size: 36px; font-weight: 700; letter-spacing: -.032em; line-height: 1.04;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(170deg, #fff, #6EB6F5);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .stats .l { font-size: 12px; color: #79828F; margin-top: 4px; max-width: 16ch; }

  .cta {
    display: inline-flex; align-items: center; gap: 9px; margin-top: 30px;
    padding: 14px 26px; min-height: 48px; border-radius: 12px;
    font-size: 15px; font-weight: 650; text-decoration: none; cursor: pointer;
    background-size: 210% 100%; will-change: transform;
    transition: background-position .7s cubic-bezier(.16,1,.3,1), box-shadow .4s;
  }
  .cta-fin { background-image: linear-gradient(115deg, #3EC6C0, #1E88E5 45%, #4A5AB9); color: #fff; box-shadow: 0 14px 32px -14px rgba(30,136,229,.95); }
  /* Il testo sopra un accento e' SEMPRE Ink (canone 3.4): #2A1F16 era un
     marrone scelto a occhio, Ink e' la regola e vale di piu' (7,97:1 contro
     6,86:1 sull'arancio). Lo stop scuro del gradiente non si sceglie: e' la
     banda k=0.72 dell'arancio, #DD7733. */
  .cta-gam { background-image: linear-gradient(115deg, #FFC24B, #FF8A3D 48%, #DD7733); color: #14101F; box-shadow: 0 14px 32px -14px rgba(255,138,61,.95); }
  .cta:hover { background-position: 100% 0; }

  .ticker {
    margin: 44px auto 0; max-width: 262px; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .ticker :global(.tk-track) { display: flex; gap: 20px; width: max-content; animation: slide 30s linear infinite; }
  @keyframes slide { to { transform: translateX(-50%); } }
  .ticker :global(.tk) { display: flex; gap: 6px; font-size: 11px; white-space: nowrap; }
  .ticker :global(.s) { color: #AEB7C4; font-weight: 650; }
  .ticker :global(.d) { font-variant-numeric: tabular-nums; }
  .ticker :global(.up) { color: #34D399; }
  .ticker :global(.down) { color: #F87171; }
  .tk-cap { text-align: center; font-size: 10.5px; color: #79828F; margin-top: 8px; }

  /* =========== GAMES =========== */
  /* LA BANDA SCENDE NELLA NOTTE, non piu' nell'alba. Il gradiente vecchio
     era il CIELO della scena illustrata (la scena non ha un fondo suo: e'
     trasparente, e questa banda si vede attraverso), quindi migrarla non e'
     decorazione: e' la migrazione del cielo. Parte dall'ink aziendale - cosi'
     la giunzione con la banda Finance resta invisibile - passa per Ink e si
     ferma su Notte #1E1830, che e' il fondo che il canone gotico da' alle
     scene. Su Notte il dado crema vale 15,97:1 e le braci arancio 7,29:1;
     sull'alba #FFE8C8 valevano 1,50:1 e 2,19:1. */
  /* L'ANELLO DI FOCUS DELLA BANDA, che qui e' messo peggio che su /games e per
     un motivo in piu': questa pagina e' sezione AZIENDA, quindi il default
     globale (`--sec-text`) e' la menta scura #0B7F5A - e la CTA della card ha
     l'anello sulla PIETRA della card, dove la menta scura vale **1,89:1**
     (sulla Notte, dove cade l'anello del resto della banda, 3,42:1: passa per
     0,42). Nessuno dei due e' un numero da lasciare. Il token della superficie
     porta l'arancio di sezione: 4,04:1 sulla Pietra, 4,77:1 sulla Pietra in
     ombra, 7,29:1 sulla Notte. Il Dado ha gia' il suo anello arancio scritto a
     mano e non cambia. */
  .gam-band {
    position: relative; overflow: hidden; padding: 118px 0 0;
    background: linear-gradient(180deg,
      #0A0E14 0%, #14101F 16%, #1E1830 42%, #1E1830 100%);
    --focus-ring: #FF8A3D;
  }
  .gam-in { position: relative; z-index: 4; }
  /* La card era CREMA con testo scuro: una finestra chiara dentro una sezione
     notturna. Nel canone il pannello e' Pietra (#4A4066, "pannelli UI, carta
     scura") con la sua banda d'ombra derivata, e il testo sopra e' quello
     della tabella 3.4: primario crema 8,85:1, secondario 5,44:1. */
  .gam-card {
    background: linear-gradient(165deg, #4A4066, #3F3657);
    border: 1px solid #6A5A93;
    border-radius: 22px; padding: 30px 32px;
    box-shadow: 0 40px 70px -40px rgba(20,16,31,.85);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  }
  /* L'etichetta e' AMBRA e non arancio, ed e' una misura non un gusto: a
     10,5px l'AA vuole 4,5:1, e l'arancio sulla pietra si ferma a 4,04:1.
     L'ambra vale 5,90:1. */
  .gam-card .lab { color: #FFC24B; }
  .gam-card .h2 { color: #FFF6EA; font-size: clamp(34px, 4.2vw, 50px); letter-spacing: -.012em; font-weight: 800; }
  .gam-card .lede { color: #C9C0DC; }
  .gam-card .lede :global(b) { color: #FFF6EA; }
  .gam-card .fact { color: #C9C0DC; }
  .gam-card .fact :global(b) { color: #FFF6EA; }

  /* =========== LO STUDIO =========== */
  .about { padding: 90px 0; background: #0A0E14; position: relative; z-index: 4; }
  .about h3 { margin: 0; font-size: 26px; letter-spacing: -.028em; }
  .about p { margin: 16px 0 0; color: #AEB7C4; max-width: 62ch; font-size: 16px; }
  .about .row { display: flex; gap: 20px; margin-top: 26px; flex-wrap: wrap; }
  .chip {
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid rgba(255,255,255,.12); border-radius: 999px;
    padding: 8px 15px; font-size: 13px; color: #AEB7C4;
    text-decoration: none; transition: border-color .3s, color .3s;
  }
  .chip:hover { border-color: #26D896; color: #F4F6F9; }

  .reveal { opacity: 0; transform: translateY(30px); transition: opacity 1s cubic-bezier(.16,1,.3,1), transform 1s cubic-bezier(.16,1,.3,1); }
  .reveal:global(.in) { opacity: 1; transform: none; }

  @media (max-width: 940px) {
    .cols { grid-template-columns: 1fr; gap: 40px; }
    .gam-card { padding: 24px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1 !important; transform: none !important; }
    .thread line { stroke-dashoffset: 0 !important; }
    .hero h1 em { animation: none; }
    .ticker :global(.tk-track) { animation: none; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

  /* Il conteggio delle statistiche: parte quando entrano in vista, e finisce.
     Nessun ciclo perpetuo. */
  const countIO = new IntersectionObserver((es) => {
    es.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      const to = Number(el.dataset.count);
      countIO.unobserve(el);
      if (reduce || to === 0) { el.textContent = String(to); return; }
      const s = performance.now();
      const step = (t: number) => {
        const p = Math.min(1, (t - s) / 1200);
        el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }, { threshold: .6 });
  document.querySelectorAll('[data-count]').forEach((el) => countIO.observe(el));

  /* Il ticker dei prezzi. Nel sito vero i dati arrivano dal feed pubblico che
     scarica anche l'app: se non risponde, restano i simboli senza variazione -
     un ticker muto e' meglio di un ticker che inventa numeri. */
  const tk = document.getElementById('tkTrack');
  if (tk) {
    const FALLBACK: Array<[string, number | null]> = [
      ['NVDA', null], ['ASML', null], ['MC.PA', null], ['ENI', null], ['ISP', null],
      ['AAPL', null], ['SAP', null], ['STLA', null], ['RACE', null], ['MSFT', null],
    ];
    const render = (rows: Array<[string, number | null]>) => {
      const html = rows.map(([s, p]) => {
        const d = p === null
          ? '<span class="d">--</span>'
          : `<span class="d ${p >= 0 ? 'up' : 'down'}">${p >= 0 ? '+' : ''}${p.toFixed(2)}%</span>`;
        return `<span class="tk"><span class="s">${s}</span>${d}</span>`;
      }).join('');
      tk.innerHTML = html + html;   /* due volte: l'animazione scorre di -50% */
    };
    render(FALLBACK);

    fetch('/top_movers.json')
      .then((r) => (r.ok ? r.json() : null))
      .then((j) => {
        const src = Array.isArray(j?.gainers) ? [...j.gainers, ...(j.losers ?? [])] : null;
        if (!src?.length) return;
        const rows = src.slice(0, 10).map((m: any) => [
          String(m.symbol ?? m.ticker ?? '?'),
          typeof m.change_percent === 'number' ? m.change_percent : null,
        ] as [string, number | null]);
        if (rows.length) render(rows);
      })
      .catch(() => { /* offline, o feed non raggiungibile: restano i simboli muti */ });
  }

  /* Il filo che si disegna scendendo. Sveglia -> un frame -> spento. */
  const thread = document.getElementById('thread');
  let ticking = false;
  function onScroll() {
    if (thread) {
      const tr = thread.getBoundingClientRect();
      thread.style.setProperty('--tp', clamp((innerHeight - tr.top) / (innerHeight * .55), 0, 1).toFixed(3));
    }
    ticking = false;
  }
  addEventListener('scroll', () => {
    if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
  }, { passive: true });
  onScroll();

  /* I bottoni magnetici. Solo con un mouse VERO: su un telefono `fine` e' falso
     e questo ramo non gira - ed e' giusto cosi', non c'e' un cursore da seguire. */
  function magnetic(el: HTMLElement, pull: number) {
    if (!fine || reduce) return;
    let tx = 0, ty = 0, cx = 0, cy = 0, live = false, raf = 0;
    const loop = () => {
      cx = lerp(cx, tx, .18); cy = lerp(cy, ty, .18);
      el.style.transform = `translate(${cx.toFixed(2)}px, ${cy.toFixed(2)}px)`;
      if (Math.abs(cx - tx) > .05 || Math.abs(cy - ty) > .05 || live) raf = requestAnimationFrame(loop);
      else { el.style.transform = ''; raf = 0; }   /* arrivato: si spegne */
    };
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      tx = (e.clientX - r.left - r.width / 2) * pull;
      ty = (e.clientY - r.top - r.height / 2) * pull;
      live = true; if (!raf) raf = requestAnimationFrame(loop);
    });
    el.addEventListener('pointerleave', () => {
      tx = 0; ty = 0; live = false; if (!raf) raf = requestAnimationFrame(loop);
    });
  }
  document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => magnetic(el, .2));
</script>
