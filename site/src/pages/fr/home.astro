---
// `/fr/home` - la home aziendale: le due divisioni, la scena, lo studio.
import fr from '../../i18n/fr';
import Layout from '../../layouts/Layout.astro';
import CompanyHome from '../../components/CompanyHome.astro';

const t = fr;
---
<Layout
  title={`PluriFin — ${t.company.hero.h1a} ${t.company.hero.h1b}`}
  description={t.company.hero.lede}
  ogTitle="PluriFin"
  ogDescription={t.company.hero.lede}
  lang="fr"
  section="company"
  pageType="organization"
>
  <CompanyHome t={t} lang="fr" />
</Layout>
