// Until S398 this page carried a different, shorter site text marked
// "Versione 1.0, 28 aprile 2026" next to the app document - that was the defect.
// GENERATED by strumenti/privacy-da-md.mjs (renderer src/lib/privacy-da-md.mjs);
// integrations/privacy-pagine.test.mjs fails if this file differs from it.
const toc = [
  { id: "s1", label: "1. Naturaleza informativa" },
  { id: "s2", label: "2. Referencias normativas" },
  { id: "s3", label: "3. Análisis IA -- advertencias específicas" },
  { id: "s4", label: "4. Sugerencias de rebalanceo" },
  { id: "s5", label: "5. Datos de mercado" },
  { id: "s6", label: "6. Cálculos fiscales" },
  { id: "s7", label: "7. Mercados extranjeros y divisas" },
  { id: "s8", label: "8. Seguridad personal" },
  { id: "s9", label: "9. Actualizaciones normativas" },
  { id: "s10", label: "10. Decisiones del Usuario -- exoneración" },
  { id: "s11", label: "11. Menores" },
  { id: "s12", label: "12. Geolocalización" },
